{
  "schema": "age-bands/1",
  "note": "The one age-band model of openlessons. A band is the age at the start of the school year, for a learner who started school at the usual age; it is a guide for choosing content, never a rule about a child. Every objective and every level of a standards framework names its bands, and a lesson's `ages` must fall inside its objectives' bands. Each band lists what it is called in the main grade systems; a system with nothing for the band is left out.",
  "systems": {
    "us": {
      "name": "United States grades",
      "jurisdiction": "US",
      "note": "Typical age at the start of the school year. Cut-off dates differ by state.",
      "sourceUrl": "https://www.thecorestandards.org/read-the-standards/"
    },
    "england": {
      "name": "England: key stages and year groups",
      "jurisdiction": "GB-ENG",
      "note": "A child is in Year 1 in the school year they turn 6. Reception and below are the early years foundation stage.",
      "sourceUrl": "https://www.gov.uk/national-curriculum"
    },
    "indonesia": {
      "name": "Indonesia: kelas and fase (Kurikulum Merdeka)",
      "jurisdiction": "ID",
      "note": "Fase A is kelas 1-2, B is 3-4, C is 5-6, D is 7-9, E is 10, F is 11-12. Children start kelas 1 at 7, and may at 6, so kelas 1 is listed in two bands.",
      "sourceUrl": "https://kurikulum.kemendikdasmen.go.id/"
    },
    "australia": {
      "name": "Australia: year levels",
      "jurisdiction": "AU",
      "note": "Foundation is the first year of school, called Kindergarten, Prep, Reception, Pre-primary or Transition by state.",
      "sourceUrl": "https://v9.australiancurriculum.edu.au/"
    },
    "india": {
      "name": "India: classes and NEP 2020 stages",
      "jurisdiction": "IN",
      "note": "The 5+3+3+4 structure: foundational (ages 3-8), preparatory (8-11), middle (11-14), secondary (14-18).",
      "sourceUrl": "https://www.education.gov.in/"
    },
    "singapore": {
      "name": "Singapore: levels",
      "jurisdiction": "SG",
      "note": "A child enters Primary 1 in the year they turn 7.",
      "sourceUrl": "https://www.moe.gov.sg/primary"
    },
    "china": {
      "name": "China: grades",
      "jurisdiction": "CN",
      "note": "Six years of primary, three of junior secondary, three of senior secondary; grade 1 starts at 6.",
      "sourceUrl": "https://www.moe.gov.cn/"
    },
    "spain": {
      "name": "Spain: cursos",
      "jurisdiction": "ES",
      "note": "Primaria runs from 6 to 12, ESO from 12 to 16, Bachillerato from 16 to 18.",
