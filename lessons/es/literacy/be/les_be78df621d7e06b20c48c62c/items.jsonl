{"schema":"item/1","id":"itm_794b852af7407b6a565ab174","kind":"story_choice","skills":["literacy.reading.retell-a-story"],"band":"easy","role":"guided","family":"adopt:gdl-story-16316:story","view":{"prompt":{"text":"Rey Gordo, Perro Flaco"},"start":"n0","nodes":[{"id":"n0","text":"Este es un rey gordo.","end":false,"choices":[{"id":"c0","label":"Siguiente","to":"n1"}]},{"id":"n1","text":"El rey gordo tiene un perro flaco. El rey gordo y su perro flaco salen a caminar.","end":false,"choices":[{"id":"c0","label":"Siguiente","to":"n2"}]},{"id":"n2","text":"El perro ve un pájaro. El perro corre tras el pájaro.","end":false,"choices":[{"id":"c0","label":"Siguiente","to":"n3"}]},{"id":"n3","text":"El rey corre tras el perro.","end":false,"choices":[{"id":"c0","label":"Siguiente","to":"n4"}]},{"id":"n4","text":"Ellos corren y corren. Ellos corren y corren por muchos días.","end":false,"choices":[{"id":"c0","label":"Siguiente","to":"n5"}]},{"id":"n5","text":"El rey atrapa el perro.","end":false,"choices":[{"id":"c0","label":"Siguiente","to":"n6"}]},{"id":"n6","text":"Ahora el rey gordo es flaco.","end":true,"choices":[]}]},"key":{"graded":false,"hints":[]},"status":"draft","provenance":{"origin":"generator","maker":"openlessons-adopt","tool":"openlessons adopt","created":"2026-11-23"}}
