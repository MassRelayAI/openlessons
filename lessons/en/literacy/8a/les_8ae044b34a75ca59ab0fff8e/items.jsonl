{"schema":"item/1","id":"itm_8dd0a320b48a3bbcddbba702","kind":"story_choice","skills":["literacy.reading.retell-a-story"],"band":"easy","role":"guided","family":"adopt:gdl-story-10078:story","view":{"prompt":{"text":"My Home"},"start":"n0","nodes":[{"id":"n0","text":"This is my home.","end":false,"choices":[{"id":"c0","label":"Next","to":"n1"}]},{"id":"n1","text":"I live here with my whole family.","end":false,"choices":[{"id":"c0","label":"Next","to":"n2"}]},{"id":"n2","text":"We take off our shoes and chappals here.","end":false,"choices":[{"id":"c0","label":"Next","to":"n3"}]},{"id":"n3","text":"This is where we wash our face and hands.","end":false,"choices":[{"id":"c0","label":"Next","to":"n4"}]},{"id":"n4","text":"I hang my clothes on the hook.","end":false,"choices":[{"id":"c0","label":"Next","to":"n5"}]},{"id":"n5","text":"My grandfather keeps his stick in the corner.","end":false,"choices":[{"id":"c0","label":"Next","to":"n6"}]},{"id":"n6","text":"We also keep our mats there.","end":false,"choices":[{"id":"c0","label":"Next","to":"n7"}]},{"id":"n7","text":"My father keeps his motorcycle outside.","end":false,"choices":[{"id":"c0","label":"Next","to":"n8"}]},{"id":"n8","text":"But his helmet is on the cupboard.","end":false,"choices":[{"id":"c0","label":"Next","to":"n9"}]},{"id":"n9","text":"My mother and grandmother keep their saris in the trunk.","end":false,"choices":[{"id":"c0","label":"Next","to":"n10"}]},{"id":"n10","text":"Tasty food is cooked in the kitchen.","end":false,"choices":[{"id":"c0","label":"Next","to":"n11"}]},{"id":"n11","text":"When it is cold, we bring out quilts.","end":false,"choices":[{"id":"c0","label":"Next","to":"n12"}]},{"id":"n12","text":"When it is hot, we use a fan.","end":false,"choices":[{"id":"c0","label":"Next","to":"n13"}]},{"id":"n13","text":"When we have important guests, we bring out the chairs.","end":false,"choices":[{"id":"c0","label":"Next","to":"n14"}]},{"id":"n14","text":"You must come and visit my home. Come soo