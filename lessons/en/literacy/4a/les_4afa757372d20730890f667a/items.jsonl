{"schema":"item/1","id":"itm_3248fa229bef3e8cffb92b38","kind":"story_choice","skills":["literacy.reading.retell-a-story"],"band":"easy","role":"guided","family":"adopt:gdl-story-2008:story","view":{"prompt":{"text":"My Teacher"},"start":"n0","nodes":[{"id":"n0","text":"I love my teacher.","end":false,"choices":[{"id":"c0","label":"Next","to":"n1"}]},{"id":"n1","text":"She is a good teacher. She is kind and patient.","end":false,"choices":[{"id":"c0","label":"Next","to":"n2"}]},{"id":"n2","text":"She has braided her hair so nicely.","end":false,"choices":[{"id":"c0","label":"Next","to":"n3"}]},{"id":"n3","text":"She has put colourful beads in her hair.","end":false,"choices":[{"id":"c0","label":"Next","to":"n4"}]},{"id":"n4","text":"Her beads are green, white, red, and yellow.","end":false,"choices":[{"id":"c0","label":"Next","to":"n5"}]},{"id":"n5","text":"Mom, please would you braid my hair like my teacher's?","end":false,"choices":[{"id":"c0","label":"Next","to":"n6"}]},{"id":"n6","text":"When I am older I will put beads in my hair.","end":false,"choices":[{"id":"c0","label":"Next","to":"n7"}]},{"id":"n7","text":"I will grow up to be just like my teacher!","end":true,"choices":[]}]},"key":{"graded":false,"hints":[]},"status":"draft","provenance":{"origin":"generator","maker":"openlessons-adopt","tool":"openlessons adopt","created":"2026-11-23"}}
