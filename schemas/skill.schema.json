{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassRelayAI/openlessons/schemas/skill.schema.json",
  "title": "skill/1: one objective of the topic graph: a thing a learner can do, in our own words",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "subject",
    "strand",
    "slug",
    "statement",
    "prerequisites",
    "status",
    "provenance",
    "topic",
    "bands"
  ],
  "properties": {
    "schema": {
      "const": "skill/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "strand": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "statement": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "description": "text per locale (ICU MessageFormat)"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "no",
          "feedback"
        ],
        "properties": {
          "no": {
            "type": "integer",
            "minimum": 1
          },
          "feedback": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "description": "text per locale (ICU MessageFormat)"
          },
          "mustAddress": {
            "type": "boolean"
          }
        }
      }
    },
    "mastery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "m",
        "n"
      ],
      "properties": {
        "model": {
          "const": "m_of_n"
        },
        "m": {
          "type": "integer",
          "minimum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "deprecated": {
      "description": "An id is never removed once released. A retired objective stays and points at what replaces it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["replacedBy"],
      "properties": {
        "replacedBy": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "reviewed",
        "published"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "maker",
        "created"
      ],
      "description": "who or what made the record; an AI-made record says so and cannot be reviewed by its maker",
      "properties": {
        "origin": {
          "enum": [
            "human",
            "ai",
            "generator"
          ],
          "description": "human: written by a person; ai: drafted by a model; generator: produced by a deterministic program"
        },
        "maker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "a public handle or an agent name; never an email address"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "kind",
              "role",
              "verdict",
              "date"
            ],
            "properties": {
              "by": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "who reviewed: for a human review that counts, a handle listed in REVIEWERS.json"
              },
              "kind": {
                "enum": [
                  "human",
                  "ai",
                  "jury"
                ],
                "description": "an ai review is advice. A jury review is the sourced AI jury of REVIEWERS.json: it counts only with its decision record (review/decisions/<id>.json), and only on a lesson or an item"
              },
              "role": {
                "enum": [
                  "subject",
                  "language",
                  "safety",
                  "licence",
                  "jury"
                ],
                "description": "subject: it teaches what it says and the answers are right; language: natural and right for the age and place; safety: nothing unsafe for a child; licence: every borrowed part may be used"
              },
              "verdict": {
                "enum": [
                  "pass",
                  "fix",
                  "fail"
                ]
              },
              "decision": {
                "type": "string",
                "pattern": "^review/decisions/(les|itm)_[0-9a-f]{24}[.]json$",
                "description": "a jury review: the decision record that settles it"
              },
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "the topic of its strand, as listed in topics/<subject>.json"
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(b[0-9]{2}-[0-9]{2}|adult)$"
      },
      "description": "the age bands (bands/age-bands.json) the objective is usually taught in"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
      },
      "description": "the languages of instruction the objective applies to, when not the subject's own list"
    }
  }
}
