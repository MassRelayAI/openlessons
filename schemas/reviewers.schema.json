{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassRelayAI/openlessons/schemas/reviewers.schema.json",
  "title": "reviewers/1: REVIEWERS.json, the people whose review can settle a record, and what each may review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviewers"
  ],
  "properties": {
    "schema": {
      "const": "reviewers/1"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handle",
          "roles",
          "locales",
          "subjects",
          "frameworks",
          "since"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "description": "the public handle the reviewer signs reviews with"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "subject",
                "language",
                "safety",
                "licence"
              ]
            }
          },
          "locales": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
                },
                {
                  "const": "*"
                }
              ]
            },
            "description": "languages they may review; * for all"
          },
          "subjects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "maxLength": 80
                },
                {
                  "const": "*"
                }
              ]
            }
          },
          "frameworks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "maxLength": 80
                },
                {
                  "const": "*"
                }
              ]
            },
            "description": "frameworks whose alignments they may review"
          },
          "since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
