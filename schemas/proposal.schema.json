{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassRelayAI/openlessons/schemas/proposal.schema.json",
  "title": "proposal/1: content offered in one file. `openlessons apply` places it in the tree; every record comes out `proposed`",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "provenance"
  ],
  "anyOf": [
    {
      "required": [
        "skills"
      ]
    },
    {
      "required": [
        "alignments"
      ]
    },
    {
      "required": [
        "lessons"
      ]
    }
  ],
  "properties": {
    "schema": {
      "const": "proposal/1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "maker",
        "created"
      ],
      "properties": {
        "origin": {
          "enum": [
            "human",
            "ai",
            "generator"
          ]
        },
        "maker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "a public handle or an agent name; never an email address"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "description": "a skill/1 record without schema, status and provenance"
      }
    },
    "alignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "standard",
          "strength"
        ],
        "description": "an alignment/1 record without schema, status and provenance"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lesson"
        ],
        "properties": {
          "lesson": {
            "type": "object",
            "required": [
              "slug",
              "locale",
              "subject",
              "title",
              "ages",
              "skills",
              "teach"
            ],
            "description": "a lesson/1 record without schema, id, status and provenance"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "band",
                "role",
                "view",
                "key"
              ],
              "description": "an item/1 record without schema, id, status and provenance"
            }
          }
        }
      }
    }
  }
}
