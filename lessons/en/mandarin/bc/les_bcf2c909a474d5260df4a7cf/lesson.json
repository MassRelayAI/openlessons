  "teach": {
    "text": "Put 是 shì (is, am) in the middle: 他是爸爸, he is dad. 我是哥哥, I am the big brother.",
    "examples": [
      "他是爸爸: he is my dad",
      "她是妈妈: she is my mum"
    ],
    "reteach": "First who (我, 他, 她), then 是, then the family word."
  },
