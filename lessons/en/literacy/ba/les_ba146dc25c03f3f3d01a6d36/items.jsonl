{"schema":"item/1","id":"itm_dafd89adbddfaa2cf2c5d910","kind":"story_choice","skills":["literacy.reading.retell-a-story"],"band":"easy","role":"guided","family":"adopt:gdl-story-2096:story","view":{"prompt":{"text":"Porridge"},"start":"n0","nodes":[{"id":"n0","text":"Zama is getting ready for school.","end":false,"choices":[{"id":"c0","label":"Next","to":"n1"}]},{"id":"n1","text":"Dad is cooking porridge for breakfast.","end":false,"choices":[{"id":"c0","label":"Next","to":"n2"}]},{"id":"n2","text":"\"Mom makes the best porridge!\" says Zama.","end":false,"choices":[{"id":"c0","label":"Next","to":"n3"}]},{"id":"n3","text":"Porridge gives Zama energy for school.","end":false,"choices":[{"id":"c0","label":"Next","to":"n4"}]},{"id":"n4","text":"The porridge is ready.","end":false,"choices":[{"id":"c0","label":"Next","to":"n5"}]},{"id":"n5","text":"Dad pours the milk, with love.","end":false,"choices":[{"id":"c0","label":"Next","to":"n6"}]},{"id":"n6","text":"\"Dad, I think this porridge needs more sugar,\" says Zama.","end":false,"choices":[{"id":"c0","label":"Next","to":"n7"}]},{"id":"n7","text":"\"Mom's porridge tastes much better than Dad's porridge,\" thinks Zama.","end":false,"choices":[{"id":"c0","label":"Next","to":"n8"}]},{"id":"n8","text":"\"Dad, please can I have more sugar?\" asks Zama.","end":false,"choices":[{"id":"c0","label":"Next","to":"n9"}]},{"id":"n9","text":"Dad gives Zama more sugar.","end":false,"choices":[{"id":"c0","label":"Next","to":"n10"}]},{"id":"n10","text":"\"Wu! Dad! You put salt on my porridge!\"","end":false,"choices":[{"id":"c0","label":"Next","to":"n11"}]},{"id":"n11","text":"\"Dad, when will Mom be home?\" asks Zama.","end":true,"choices":[]}]},"key":{"graded":false,"hints":[]},"status":"draft","provenance":{"origin":"generator","maker":"openlessons-adopt","tool":"openlessons adopt","created":"2026-11-23"}}
