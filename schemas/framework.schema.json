{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassRelayAI/openlessons/schemas/framework.schema.json",
  "title": "framework/1: a standards framework, held as a REFERENCE with its terms of reuse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "publisher",
    "jurisdiction",
    "version",
    "sourceUrl",
    "terms"
  ],
  "properties": {
    "schema": {
      "const": "framework/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^([A-Z]{2}(-[A-Z0-9]{1,3})?|international)$",
      "description": "ISO 3166 code, or international"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "quote",
        "termsUrl",
        "note",
        "reviewed"
      ],
      "properties": {
        "class": {
          "enum": [
            "open",
            "attribution",
            "reference_only"
          ]
        },
        "licence": {
          "type": "string",
          "description": "SPDX id where the publisher names an open licence"
        },
        "quote": {
          "enum": [
            "official_text",
            "ids_and_titles",
            "ids_only"
          ],
          "description": "the most this repository may copy from the publisher: full official wording; identifiers and official titles; identifiers only"
        },
        "notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "termsUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reviewed": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "the day the terms at termsUrl were last read for this record; null = not read, and the framework is then reference_only / ids_only"
        }
      }
    }
  }
}
