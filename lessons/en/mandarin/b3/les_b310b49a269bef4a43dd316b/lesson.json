  "teach": {
    "text": "Wǒ is I, nǐ is you. Tā is he or she: 他 for a boy, 她 for a girl. Add 们 for more than one.",
    "examples": [
      "我 wǒ: I",
      "我们 wǒmen: we"
    ],
    "reteach": "Point to yourself for 我, to a friend for 你, and to someone over there for 他 or 她."
  },
