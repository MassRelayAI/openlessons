{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassRelayAI/openlessons/schemas/path.schema.json",
  "title": "path/1: an ordered course of lessons",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "locale",
    "subject",
    "title",
    "ages",
    "units",
    "status",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "path/1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
    },
    "targetLocale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 3,
          "maximum": 18
        },
        "max": {
          "type": "integer",
          "minimum": 3,
          "maximum": 18
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "raised when a reviewed path is reopened for a change (absent = 1)"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "lessons"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^les_[0-9a-f]{24}$"
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "reviewed",
        "published"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "maker",
        "created"
      ],
      "description": "who or what made the record; an AI-made record says so and cannot be reviewed by its maker",
      "properties": {
        "origin": {
          "enum": [
            "human",
            "ai",
            "generator"
          ],
          "description": "human: written by a person; ai: drafted by a model; generator: produced by a deterministic program"
        },
        "maker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "a public handle or an agent name; never an email address"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "kind",
              "role",
              "verdict",
              "date"
            ],
            "properties": {
              "by": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "who reviewed: for a human review that counts, a handle listed in REVIEWERS.json"
              },
              "kind": {
                "enum": [
                  "human",
                  "ai"
                ],
                "description": "an ai review is advice; only a human review can settle a record"
              },
              "role": {
                "enum": [
                  "subject",
                  "language",
                  "safety",
                  "licence"
                ],
                "description": "subject: it teaches what it says and the answers are right; language: natural and right for the age and place; safety: nothing unsafe for a child; licence: every borrowed part may be used"
              },
              "verdict": {
                "enum": [
                  "pass",
                  "fix",
                  "fail"
                ]
              },
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    }
  }
}
