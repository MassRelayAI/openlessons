{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassRelayAI/openlessons/schemas/age-bands.schema.json",
  "title": "age-bands/1: the one age-band model, and how each band reads in the grade systems of the main countries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "note",
    "systems",
    "bands"
  ],
  "properties": {
    "schema": {
      "const": "age-bands/1"
    },
    "note": {
      "type": "string"
    },
    "systems": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "jurisdiction",
          "note",
          "sourceUrl"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "jurisdiction": {
            "type": "string",
            "pattern": "^([A-Z]{2}(-[A-Z0-9]{1,3})?|international)$"
          },
          "note": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "ages",
          "stage",
          "systems"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(b[0-9]{2}-[0-9]{2}|adult)$"
          },
          "label": {
            "type": "string"
          },
          "ages": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              }
            }
          },
          "stage": {
            "type": "string",
            "description": "our own name for the stage"
          },
          "systems": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "description": "system id -> what the band is called there; a system with nothing for the band is left out"
          }
        }
      }
    }
  }
}
