{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassRelayAI/openlessons/schemas/framework.schema.json",
  "title": "framework/1: one entry of the standards registry: a framework held as a REFERENCE, with its issuer, span and terms of reuse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "publisher",
    "jurisdiction",
    "version",
    "sourceUrl",
    "terms",
    "subjects",
    "span"
  ],
  "properties": {
    "schema": {
      "const": "framework/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^([A-Z]{2}(-[A-Z0-9]{1,3})?|international)$",
      "description": "ISO 3166 code, or international"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "quote",
        "termsUrl",
        "note",
        "reviewed"
      ],
      "properties": {
        "class": {
          "enum": [
            "open",
            "attribution",
            "reference_only"
          ]
        },
        "licence": {
          "type": "string",
          "description": "SPDX id where the publisher names an open licence"
        },
        "quote": {
          "enum": [
            "official_text",
            "ids_and_titles",
            "ids_only"
          ],
          "description": "the most this repository may copy from the publisher: full official wording; identifiers and official titles; identifiers only"
        },
        "notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "termsUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reviewed": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "the day the terms at termsUrl were last read for this record; null = not read, and the framework is then reference_only / ids_only"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "a short quotation from the page at termsUrl that shows the terms, as read on the `reviewed` day"
        },
        "guard": {
          "enum": [
            "fingerprints",
            "paraphrase_rule"
          ],
          "description": "how our own wording is kept clear of this framework's text when we may not copy it. fingerprints: gates/data/protected/<framework>.txt holds hashes of the official text and the gate content.no-copied-text refuses a matching passage. paraphrase_rule: no official text could be fingerprinted, so the guard is the rule (write it in your own words) and the licence reviewer alone"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "maths",
          "literacy",
          "science",
          "languages",
          "computing",
          "arts",
          "wellbeing",
          "life-skills",
          "social-studies",
          "all"
        ]
      },
      "description": "the subject areas the framework covers (`all` for a whole-school curriculum)"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ages",
        "grades"
      ],
      "properties": {
        "ages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          }
        },
        "grades": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "the span in the publisher's own terms (K-12, Year 1 to Year 11, Fase A-F, A1-C2)"
        }
      }
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
      },
      "description": "the languages the official text is published in"
    }
  }
}
