    },
    "cefr": {
      "name": "CEFR levels, as a school foreign-language range",
      "jurisdiction": "international",
      "note": "CEFR levels describe proficiency, not age. These are the levels a school learner of a foreign language is usually working at; a first language or an early start sits outside them.",
